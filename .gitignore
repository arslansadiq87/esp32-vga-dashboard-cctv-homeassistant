# PlatformIO build products
.pio/

# PlatformIO / editor-generated workspace state
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Locally configured credentials (templates ending in .example.h are safe to commit)
include/dashboard_local.h
include/camera_local.h
.env
.env.*

# ESP-IDF generated config; retain the checked-in project defaults
sdkconfig
sdkconfig.*
!sdkconfig.defaults

# Generated ESP-IDF managed dependencies
managed_components/

# Compiled artifacts and Python cache
*.bin
*.elf
*.map
__pycache__/
*.py[cod]

# Private keys and credential bundles. Public CA certificates in certs/*.crt are intentional.
*.key
*.pem
*.p12
*.pfx
